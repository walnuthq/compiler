#! Inputs:  [key3, key2, key1, key0, start_addr, end_addr, ...]
#! Outputs: [...]
#! Side effects: advice_map[key] <- mem[start_addr..end_addr]
pub proc adv_insert_mem
    adv.insert_mem
    drop
    drop
    dropw
end

